<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" identifier="ITEM_MULTI_PART" title="Twee delen" adaptive="false" time-dependent="false" xml:lang="nl-NL">
  <qti-response-declaration identifier="R1" cardinality="single" base-type="identifier"><qti-correct-response><qti-value>ja</qti-value></qti-correct-response></qti-response-declaration>
  <qti-response-declaration identifier="R2" cardinality="single" base-type="string"></qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float"/>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float"><qti-default-value><qti-value>3</qti-value></qti-default-value></qti-outcome-declaration>

  <qti-item-body>
    <p>Een plant staat een week in het donker.</p>
    <qti-choice-interaction response-identifier="R1" max-choices="1">
      <qti-prompt>Groeit de plant nog?</qti-prompt>
      <qti-simple-choice identifier="ja">Ja</qti-simple-choice>
      <qti-simple-choice identifier="nee">Nee</qti-simple-choice>
    </qti-choice-interaction>
    <qti-extended-text-interaction response-identifier="R2" expected-lines="4">
      <qti-prompt>Leg je antwoord uit.</qti-prompt>
    </qti-extended-text-interaction>
    <qti-rubric-block view="scorer" use="scoring"><qti-content-body><ul><li>1 punt: ja</li><li>2 punten: de plant gebruikt reservevoedsel / wordt lang en bleek</li></ul></qti-content-body></qti-rubric-block>
    <qti-feedback-block outcome-identifier="FEEDBACK" identifier="X" show-hide="show"><qti-content-body>Geheime feedback</qti-content-body></qti-feedback-block>
  </qti-item-body>
</qti-assessment-item>
