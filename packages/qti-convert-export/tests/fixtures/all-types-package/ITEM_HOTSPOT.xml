<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" identifier="ITEM_HOTSPOT" title="Hotspot" adaptive="false" time-dependent="false" xml:lang="nl-NL">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier"><qti-correct-response><qti-value>SUN</qti-value></qti-correct-response></qti-response-declaration>

  <qti-item-body>
    <qti-hotspot-interaction response-identifier="RESPONSE" max-choices="1">
      <qti-prompt>Wat geeft licht en warmte?</qti-prompt>
      <img src="resources/scene.png" width="400" height="300" alt="Tekening van een huis"/>
      <qti-hotspot-choice identifier="SUN" shape="circle" coords="330,60,35"/>
      <qti-hotspot-choice identifier="HOUSE" shape="rect" coords="60,120,180,200"/>
      <qti-hotspot-choice identifier="TREE" shape="poly" coords="210,80,290,80,290,160,210,160"/>
    </qti-hotspot-interaction>
  </qti-item-body>
</qti-assessment-item>
