<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0" identifier="ITEM_MEDIA" title="Luisteren" adaptive="false" time-dependent="false" xml:lang="nl-NL">
  <qti-response-declaration identifier="MEDIA" cardinality="single" base-type="integer"></qti-response-declaration>
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier"><qti-correct-response><qti-value>B</qti-value></qti-correct-response></qti-response-declaration>

  <qti-item-body>
    <qti-media-interaction response-identifier="MEDIA" max-plays="2">
      <qti-prompt>Luister naar het fragment.</qti-prompt>
      <audio src="resources/fragment.mp3"/>
    </qti-media-interaction>
    <qti-choice-interaction response-identifier="RESPONSE" max-choices="1">
      <qti-prompt>Waar gaat het fragment over?</qti-prompt>
      <qti-simple-choice identifier="A">Het weer</qti-simple-choice>
      <qti-simple-choice identifier="B">Sport</qti-simple-choice>
    </qti-choice-interaction>
  </qti-item-body>
</qti-assessment-item>
